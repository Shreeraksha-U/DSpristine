# Copy this file to .env and adjust values as needed.
# .env is git-ignored - never commit real secrets.

# Port the Flask API/app runs on
PORT=5000

# true/false - never enable debug mode in production
FLASK_DEBUG=false

# Which trained pipeline to serve: random_forest | decision_tree
MODEL_TYPE=random_forest

# CORS origin allowed to call /api/*. Use "*" for local dev, or lock this
# down to your deployed frontend URL in production.
ALLOWED_ORIGIN=*
